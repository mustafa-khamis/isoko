{
  "source": "/(.*)",
  "has": [
    {
      "type": "host",
      "value": "^www\\.rwanmart\\.com$"
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/listing/:id",
      "destination": "/api/render"
    },
    {
      "source": "/browse",
      "destination": "/api/render"
    },
    {
      "source": "/seller/:id",
      "destination": "/api/render"
    },
    {
      "source": "/",
      "destination": "/api/render"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}